<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd" >
<suite name="SuiteGroupRegression" verbose="2" parallel="false">
    
    <listeners>
        <listener class-name="listeners.TestListener"/>
    </listeners>

    <test name="RegressionGroupTests">
        <groups>
            <run>
                <include name="regression"/>
            </run>
        </groups>
        <packages>
            <package name="tests"/>
        </packages>
    </test>

</suite>

